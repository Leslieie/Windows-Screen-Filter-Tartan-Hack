{
  "name": "screentint",
  "version": "1.0.0",
  "description": "ScreenTint — Universal Windows Theme Engine",
  "main": "main.js",
  "type": "commonjs",
  "scripts": {
    "start": "electron main.js",
    "build:native": "node-gyp rebuild",
    "rebuild": "electron-rebuild -f -w screentint_native",
    "dist": "set CSC_IDENTITY_AUTO_DISCOVERY=false&& electron-builder --win nsis",
    "test": "jest --verbose",
    "test:watch": "jest --watch --verbose",
    "harness": "node src/shared/matrix-test-harness.js"
  },
  "dependencies": {
    "node-addon-api": "^7.0.0",
    "node-window-manager": "^2.2.4"
  },
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^26.7.0",
    "electron-rebuild": "^3.2.9",
    "jest": "^29.0.0",
    "node-gyp": "^10.0.0"
  },
  "build": {
    "appId": "com.screentint.app",
    "productName": "ScreenTint",
    "files": [
      "**/*",
      "!bin/**"
    ],
    "asarUnpack": [
      "build/Release/*.node"
    ],
    "extraResources": [
      {
        "from": "build/Release/screentint_native.node",
        "to": "native/screentint_native.node"
      },
      {
        "from": "Icon.ico",
        "to": "Icon.ico"
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "Icon.ico",
      "signAndEditExecutable": false
    },
    "nsis": {
      "include": "build/installer.nsh",
      "createDesktopShortcut": false,
      "createStartMenuShortcut": false,
      "installerIcon": "Icon.ico",
      "uninstallerIcon": "Icon.ico",
      "installerHeaderIcon": "Icon.ico"
    }
  }
}
